<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_employee_advance" model="ir.sequence">
        <field name="name">Anticipo de Sueldo</field>
        <field name="code">aerotec.employee.advance</field>
        <field name="prefix">ANT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_expense_report" model="ir.sequence">
        <field name="name">Rendición de Gastos</field>
        <field name="code">aerotec.expense.report</field>
        <field name="prefix">REN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
