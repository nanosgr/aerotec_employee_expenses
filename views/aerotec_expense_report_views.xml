<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista lista de rendiciones -->
    <record id="view_expense_report_tree" model="ir.ui.view">
        <field name="name">aerotec.expense.report.tree</field>
        <field name="model">aerotec.expense.report</field>
        <field name="arch" type="xml">
            <list string="Rendiciones de Gastos"
                decoration-info="state == 'draft'"
                decoration-warning="state == 'submitted'"
                decoration-success="state == 'posted'"
                decoration-primary="state == 'approved'">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="advance_id"/>
                <field name="total_expenses"/>
                <field name="surplus_amount" optional="show"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'submitted'"
                    decoration-primary="state == 'approved'"
                    decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario de rendición -->
    <record id="view_expense_report_form" model="ir.ui.view">
        <field name="name">aerotec.expense.report.form</field>
        <field name="model">aerotec.expense.report</field>
        <field name="arch" type="xml">
            <form string="Rendición de Gastos">
                <header>
                    <button name="action_submit" string="Enviar para aprobación" type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>
                    <button name="action_approve" string="Aprobar" type="object"
                        class="btn-primary"
                        invisible="state != 'submitted'"
                        groups="aerotec_employee_expenses.group_expense_manager"/>
                    <button name="action_post" string="Contabilizar" type="object"
                        class="btn-primary"
                        invisible="state != 'approved'"
                        groups="aerotec_employee_expenses.group_expense_manager"/>
                    <button name="action_reset_to_draft" string="Devolver a borrador" type="object"
                        invisible="state != 'submitted'"
                        groups="aerotec_employee_expenses.group_expense_manager"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button" icon="fa-book"
                            invisible="not account_move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Asiento</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Rendición">
                            <field name="advance_id" options="{'no_create': True}"
                                readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group string="Totales">
                            <field name="total_expenses"/>
                            <field name="surplus_amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group string="Motivo de rechazo" invisible="not rejection_reason">
                        <field name="rejection_reason" readonly="1" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Líneas de gasto">
                            <field name="line_ids"
                                readonly="state in ('submitted', 'approved', 'posted')">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="expense_account_id" options="{'no_create': True}"/>
                                    <field name="amount"/>
                                    <field name="vendor_bill_id" optional="show" options="{'no_create': True}"/>
                                    <field name="attachment_count" widget="integer" string="Adjuntos" readonly="1"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones">
                            <field name="notes"
                                placeholder="Observaciones del empleado sobre esta rendición..."
                                readonly="state in ('submitted', 'approved', 'posted')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista búsqueda de rendiciones -->
    <record id="view_expense_report_search" model="ir.ui.view">
        <field name="name">aerotec.expense.report.search</field>
        <field name="model">aerotec.expense.report</field>
        <field name="arch" type="xml">
            <search string="Buscar rendiciones">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="advance_id"/>
                <separator/>
                <filter string="Borradores" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Enviadas" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Aprobadas" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Contabilizadas" name="posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter string="Pendientes de acción" name="pending"
                    domain="[('state', 'in', ('submitted', 'approved'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Mes" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_expense_report" model="ir.actions.act_window">
        <field name="name">Rendiciones de Gastos</field>
        <field name="res_model">aerotec.expense.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_expense_report_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay rendiciones de gastos
            </p>
            <p>
                Las rendiciones son presentadas por los empleados desde el portal de Odoo
                para imputar sus gastos contra el anticipo recibido.
            </p>
        </field>
    </record>

</odoo>
