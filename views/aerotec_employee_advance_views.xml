<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista lista de anticipos -->
    <record id="view_employee_advance_tree" model="ir.ui.view">
        <field name="name">aerotec.employee.advance.tree</field>
        <field name="model">aerotec.employee.advance</field>
        <field name="arch" type="xml">
            <list string="Anticipos de Sueldo" decoration-info="state == 'draft'" decoration-success="state == 'settled'" decoration-warning="state == 'confirmed'">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="payment_method"/>
                <field name="journal_id"/>
                <field name="amount"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'confirmed'"
                    decoration-success="state == 'settled'"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario de anticipo -->
    <record id="view_employee_advance_form" model="ir.ui.view">
        <field name="name">aerotec.employee.advance.form</field>
        <field name="model">aerotec.employee.advance</field>
        <field name="arch" type="xml">
            <form string="Anticipo de Sueldo">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        groups="aerotec_employee_expenses.group_expense_manager,account.group_account_invoice"/>
                    <button name="action_reset_draft" string="Volver a borrador" type="object"
                        invisible="state != 'confirmed'"
                        groups="aerotec_employee_expenses.group_expense_manager,account.group_account_invoice"
                        confirm="¿Está seguro? Esto revertirá el asiento contable del anticipo."/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,settled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button" icon="fa-book"
                            invisible="not account_move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Asiento</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Empleado y fecha">
                            <field name="employee_id" readonly="state in ('confirmed', 'settled')"/>
                            <field name="date" readonly="state in ('confirmed', 'settled')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Pago">
                            <field name="payment_method" readonly="state in ('confirmed', 'settled')"/>
                            <field name="journal_id" options="{'no_create': True}" readonly="state in ('confirmed', 'settled')"/>
                            <field name="amount" readonly="state in ('confirmed', 'settled')"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="advance_account_id" options="{'no_create': True}" readonly="state in ('confirmed', 'settled')"/>
                        </group>
                    </group>
                    <group string="Rendición asociada" invisible="not expense_report_id">
                        <field name="expense_report_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Observaciones">
                            <field name="notes" placeholder="Notas internas sobre este anticipo..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista búsqueda de anticipos -->
    <record id="view_employee_advance_search" model="ir.ui.view">
        <field name="name">aerotec.employee.advance.search</field>
        <field name="model">aerotec.employee.advance</field>
        <field name="arch" type="xml">
            <search string="Buscar anticipos">
                <field name="name"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="Borradores" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmados" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Liquidados" name="settled" domain="[('state', '=', 'settled')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Mes" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_employee_advance" model="ir.actions.act_window">
        <field name="name">Anticipos de Sueldo</field>
        <field name="res_model">aerotec.employee.advance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employee_advance_search"/>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear el primer anticipo de sueldo
            </p>
            <p>
                Los anticipos de sueldo permiten registrar el dinero entregado a los empleados
                para cubrir gastos fuera de la empresa.
            </p>
        </field>
    </record>

</odoo>
