<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.aerotec.expenses</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="Gastos de Empleados" name="employee_expenses_setting_container">
                    <setting string="Cuenta de anticipos de sueldo"
                        help="Cuenta contable que se debita al crear un anticipo y se acredita al contabilizar la rendición.">
                        <field name="advance_account_id" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Cuenta de descuentos de sueldo"
                        help="Cuenta usada cuando el empleado devuelve menos del remanente calculado. El saldo queda pendiente de descuento en el próximo pago de sueldo.">
                        <field name="salary_deduction_account_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_account" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.aerotec.expenses.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Gastos de Empleados (Portal)" name="employee_expenses_portal_setting_container">
                    <setting string="Cuentas de gasto habilitadas en portal" company_dependent="1"
                        help="Cuentas contables que los empleados pueden elegir al cargar sus gastos desde el portal. Si no se selecciona ninguna, se permiten todas las cuentas de tipo gasto.">
                        <field name="expense_portal_allowed_account_ids" widget="many2many_tags"
                            placeholder="Todas las cuentas de tipo gasto" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
