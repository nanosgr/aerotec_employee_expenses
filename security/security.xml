<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Grupos -->
    <record id="group_expense_manager" model="res.groups">
        <field name="name">Gerente de Gastos de Empleados</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_expense_user" model="res.groups">
        <field name="name">Usuario de Gastos de Empleados</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('aerotec_employee_expenses.group_expense_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Reglas de registro -->

    <!-- Regla para usuarios de portal: solo ven sus propias rendiciones -->
    <record id="rule_expense_report_portal" model="ir.rule">
        <field name="name">Rendiciones: solo las propias (portal)</field>
        <field name="model_id" ref="aerotec_employee_expenses.model_aerotec_expense_report"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Regla para usuarios de portal: solo ven sus propias líneas de gasto -->
    <record id="rule_expense_line_portal" model="ir.rule">
        <field name="name">Líneas de gasto: solo las propias (portal)</field>
        <field name="model_id" ref="aerotec_employee_expenses.model_aerotec_expense_line"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Regla para usuarios de portal: solo ven sus propios anticipos -->
    <record id="rule_advance_portal" model="ir.rule">
        <field name="name">Anticipos: solo los propios (portal)</field>
        <field name="model_id" ref="aerotec_employee_expenses.model_aerotec_employee_advance"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
