<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_expense_detail" name="Detalle de Rendición de Gastos">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'expenses'"/>
            <div class="o_portal_wrap">
                <div class="container py-4">

                    <!-- Mensajes de error -->
                    <t t-if="error_message">
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                <t t-foreach="error_message" t-as="msg">
                                    <li><t t-out="msg"/></li>
                                </t>
                            </ul>
                        </div>
                    </t>

                    <!-- Cabecera de la rendición -->
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <h2>
                                Rendición <t t-out="report.name"/>
                            </h2>
                            <p class="text-muted mb-1">
                                Anticipo: <strong><t t-out="report.advance_id.name"/></strong>
                                — <t t-out="report.currency_id.symbol"/>
                                <t t-out="'%.2f' % report.advance_id.amount"/>
                                (<t t-out="dict(report.advance_id._fields['payment_method'].selection).get(report.advance_id.payment_method)"/>)
                            </p>
                            <p class="text-muted">
                                Fecha: <t t-out="report.date"/>
                            </p>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <span t-att-class="'badge fs-6 ' + {
                                'draft': 'bg-secondary',
                                'submitted': 'bg-warning text-dark',
                                'approved': 'bg-primary',
                                'posted': 'bg-success',
                            }.get(report.state, 'bg-secondary')">
                                <t t-out="dict(report._fields['state'].selection).get(report.state)"/>
                            </span>
                        </div>
                    </div>

                    <!-- Resumen de montos -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h6 class="card-subtitle text-muted mb-1">Anticipo recibido</h6>
                                    <h4 class="card-title mb-0">
                                        <t t-out="report.currency_id.symbol"/>
                                        <t t-out="'%.2f' % report.advance_id.amount"/>
                                    </h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h6 class="card-subtitle text-muted mb-1">Total gastos</h6>
                                    <h4 class="card-title mb-0">
                                        <t t-out="report.currency_id.symbol"/>
                                        <t t-out="'%.2f' % report.total_expenses"/>
                                    </h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div t-att-class="'card text-center ' + ('border-warning' if report.surplus_amount > 0 else '')">
                                <div class="card-body">
                                    <h6 class="card-subtitle text-muted mb-1">Remanente a devolver</h6>
                                    <h4 t-att-class="'card-title mb-0 ' + ('text-warning' if report.surplus_amount > 0 else 'text-success')">
                                        <t t-out="report.currency_id.symbol"/>
                                        <t t-out="'%.2f' % report.surplus_amount"/>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Motivo de rechazo -->
                    <t t-if="report.rejection_reason">
                        <div class="alert alert-warning mb-4">
                            <strong>Motivo de rechazo:</strong> <t t-out="report.rejection_reason"/>
                        </div>
                    </t>

                    <!-- Líneas de gasto existentes -->
                    <h5>Comprobantes cargados</h5>
                    <t t-if="report.line_ids">
                        <div class="table-responsive mb-3">
                            <table class="table">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Descripción</th>
                                        <th>Cuenta</th>
                                        <th class="text-end">Monto</th>
                                        <th>Adjuntos</th>
                                        <t t-if="report.state == 'draft'">
                                            <th></th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="report.line_ids" t-as="line">
                                        <tr>
                                            <td><t t-out="line.date"/></td>
                                            <td>
                                                <t t-out="line.name"/>
                                                <t t-if="line.notes">
                                                    <br/>
                                                    <small class="text-muted"><t t-out="line.notes"/></small>
                                                </t>
                                            </td>
                                            <td>
                                                <small>
                                                    <t t-out="line.expense_account_id.code"/>
                                                    - <t t-out="line.expense_account_id.name"/>
                                                </small>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="line.currency_id.symbol"/>
                                                <t t-out="'%.2f' % line.amount"/>
                                            </td>
                                            <td>
                                                <t t-if="line.attachment_ids">
                                                    <t t-foreach="line.attachment_ids" t-as="att">
                                                        <a t-att-href="'/web/content/%d?download=true' % att.id"
                                                            class="badge bg-light text-dark border me-1"
                                                            target="_blank">
                                                            <i class="fa fa-paperclip me-1"/>
                                                            <t t-out="att.name"/>
                                                        </a>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">—</span>
                                                </t>
                                            </td>
                                            <t t-if="report.state == 'draft'">
                                                <td>
                                                    <form t-att-action="'/my/expenses/%d/line/%d/delete' % (report.id, line.id)"
                                                        method="post"
                                                        onsubmit="return confirm('¿Eliminar esta línea?')">
                                                        <input type="hidden" name="csrf_token"
                                                            t-att-value="request.csrf_token()"/>
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="fa fa-trash"/>
                                                        </button>
                                                    </form>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="table-light fw-bold">
                                        <td colspan="3" class="text-end">Total:</td>
                                        <td class="text-end">
                                            <t t-out="report.currency_id.symbol"/>
                                            <t t-out="'%.2f' % report.total_expenses"/>
                                        </td>
                                        <t t-if="report.state == 'draft'"><td></td></t>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </t>
                    <t t-else="">
                        <p class="text-muted">Todavía no cargaste ningún comprobante.</p>
                    </t>

                    <!-- Formulario para agregar línea (solo en borrador) -->
                    <t t-if="report.state == 'draft'">
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Agregar comprobante</h6>
                            </div>
                            <div class="card-body">
                                <form t-att-action="'/my/expenses/%d/add-line' % report.id"
                                    method="post"
                                    enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token"
                                        t-att-value="request.csrf_token()"/>
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <label class="form-label" for="line_date">Fecha *</label>
                                            <input type="date" name="date" id="line_date"
                                                t-att-class="'form-control' + (' is-invalid' if error.get('date') else '')"
                                                t-att-value="form_data.get('date', '')"/>
                                        </div>
                                        <div class="col-md-9">
                                            <label class="form-label" for="line_name">Descripción *</label>
                                            <input type="text" name="name" id="line_name"
                                                t-att-class="'form-control' + (' is-invalid' if error.get('name') else '')"
                                                t-att-value="form_data.get('name', '')"
                                                placeholder="Ej: Combustible, Hotel, Viáticos..."/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="line_account">Cuenta de gasto *</label>
                                            <select name="expense_account_id" id="line_account"
                                                t-att-class="'form-select' + (' is-invalid' if error.get('expense_account_id') else '')">
                                                <option value="">-- Seleccioná una cuenta --</option>
                                                <t t-foreach="expense_accounts" t-as="acc">
                                                    <option t-att-value="acc.id"
                                                        t-att-selected="str(acc.id) == str(form_data.get('expense_account_id', ''))">
                                                        <t t-out="acc.code"/> - <t t-out="acc.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label" for="line_amount">Monto *</label>
                                            <div class="input-group">
                                                <span class="input-group-text">
                                                    <t t-out="report.currency_id.symbol"/>
                                                </span>
                                                <input type="number" name="amount" id="line_amount"
                                                    step="0.01" min="0.01"
                                                    t-att-class="'form-control' + (' is-invalid' if error.get('amount') else '')"
                                                    t-att-value="form_data.get('amount', '')"/>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label" for="line_attachments">Comprobante(s)</label>
                                            <input type="file" name="attachments" id="line_attachments"
                                                class="form-control" multiple="multiple"
                                                accept="image/*,application/pdf"/>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label" for="line_notes">Notas adicionales</label>
                                            <input type="text" name="notes" id="line_notes"
                                                class="form-control"
                                                t-att-value="form_data.get('notes', '')"
                                                placeholder="Opcional"/>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="fa fa-plus me-1"/> Agregar gasto
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Botón enviar rendición -->
                        <t t-if="report.line_ids">
                            <div class="d-grid gap-2">
                                <form t-att-action="'/my/expenses/%d/submit' % report.id" method="post">
                                    <input type="hidden" name="csrf_token"
                                        t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-success btn-lg w-100"
                                        onclick="return confirm('¿Enviás la rendición para aprobación? Ya no podrás modificarla.')">
                                        <i class="fa fa-paper-plane me-2"/> Enviar rendición para aprobación
                                    </button>
                                </form>
                            </div>
                        </t>
                    </t>

                    <!-- Mensaje de estado cuando ya está enviada -->
                    <t t-if="report.state in ('submitted', 'approved', 'posted')">
                        <div class="alert alert-info mt-4">
                            <t t-if="report.state == 'submitted'">
                                <i class="fa fa-clock-o me-2"/>
                                Tu rendición fue enviada y está esperando aprobación.
                            </t>
                            <t t-if="report.state == 'approved'">
                                <i class="fa fa-check me-2"/>
                                Tu rendición fue aprobada y está siendo procesada por Contabilidad.
                            </t>
                            <t t-if="report.state == 'posted'">
                                <i class="fa fa-check-circle me-2"/>
                                Tu rendición fue contabilizada. El anticipo queda liquidado.
                            </t>
                        </div>
                    </t>

                    <div class="mt-3">
                        <a href="/my/expenses" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-1"/> Volver a mis rendiciones
                        </a>
                    </div>

                </div>
            </div>
        </t>
    </template>

</odoo>
